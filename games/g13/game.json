{
  "title": "散戏之后",
  "intro": "散场的木偶剧院落了锁，你被忘在后台。收线要照走位倒行，太平门只认那把拼得齐三齿的戏钥——赶在天亮前，把这一夜的戏真正收完，从台仓走出去。",
  "start": "hall",
  "rooms": {
    "hall": {
      "n": "观众厅",
      "d": "座椅一排排翻扣在座板上，台口的大幕落到底，一盏场灯还亮着昏黄的光，头顶吊灯的铁链歪着，链节锈得发黑。最近一张椅背上搭着卷了角的旧节目单。"
    },
    "pit": {
      "n": "乐池",
      "d": "比观众席低一级的乐池里，谱架摊着翻烂的总谱。角落堆着卸下来的道具箱，箱缝里露出半张硬纸板。"
    },
    "stage": {
      "n": "舞台",
      "d": "台板撒着滑石粉，生偶执马鞭、旦偶执团扇、丑偶摇破蒲扇，三只提线木偶悬在半空收着架势。侧幕叠了几层，道具间的门挨着上场门。"
    },
    "dressing": {
      "n": "化妆间",
      "d": "镜灯全灭了，镜台上排着卸妆的膏盒。墙上挂着戏服，镜柜的柜门上着一把小锁。"
    },
    "props": {
      "n": "道具间",
      "d": "架板上码着刀枪把子，墙钉挂着一副黄铜钥匙坯。门边的挂板黑底白字，写着戏钥的规矩。"
    },
    "booth": {
      "n": "操纵台室",
      "d": "悬在台口上方的操纵台室里，三根收线绳垂在台沿，绳牌上各拴着一件缩微道具：马鞭、团扇、蒲扇。窄窗望得见观众厅的场灯。"
    },
    "under": {
      "n": "台仓",
      "d": "台仓堆着旧布景和卷起的毯子，太平门斜嵌在墙根，门上横着一根带销的铁闩。"
    }
  },
