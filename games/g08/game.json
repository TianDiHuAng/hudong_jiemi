{
  "title": "光路暗语",
  "intro": "浓雾封海，灯塔守一夜未归。你是来替班的港务学员：塔门的角位锁认光路不认人，进塔之后还得给油将燃尽的灯器续油、校准，让光照常扫过主航道。",
  "start": "steps",
  "rooms": {
    "steps": {
      "n": "塔基石阶",
      "d": "石阶绕着塔基盘上去，包铁塔门上嵌着一具三钮角位锁。头顶的光束每隔几息扫过雾面，野海棠贴着石缝生长。"
    },
    "cottage": {
      "n": "守塔小屋",
      "d": "小屋虚掩着门。桌上值班簿摊开在昨页，枕边搁着没织完的毛线，墙上的雨衣还在滴水。"
    },
    "platform": {
      "n": "眺望平台",
      "d": "平台探在海崖上，木栏挂满露水。港务告示牌立在栏边，漆字画着三枚浮标的位置，雾从牌面缓缓爬过。"
    },
    "hall": {
      "n": "门厅",
      "d": "门厅里码着备用灯芯和工具架，雨衣钩上挂着蓑衣。折叠梯吊在梁上，拉绳只剩个断头。"
    },
    "shaft": {
      "n": "梯井",
      "d": "螺旋铁梯贴壁盘旋，踏板擦得发亮。越往上风声越紧，塔壁上刻着一道道旧潮位线。"
    },
    "lamp": {
      "n": "灯室",
      "d": "巨大灯器蹲在旋转座上，油表的浮标贴着底。转向轨上首照角卡死在正东，镜面在雾夜里泛着幽光。"
    }
  },
  "items": {
    "rope": "一股浸油麻绳",
    "kerosene": "煤油桶"
  },
