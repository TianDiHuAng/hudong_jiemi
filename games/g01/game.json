{
  "title": "最后一次供电",
  "intro": "暴风雪封了山，应急供电窗口只开到凌晨一点。让那台老柴油机转起来，把滞留站房的游客用末班救援缆车送下山。",
  "start": "platform",
  "rooms": {
    "platform": {
      "n": "上行站台",
      "d": "露天站台积雪没过脚踝，橙红色的车厢冻在线上，安全门闩得死死的。风卷着雪碴子往领口里钻，站房的窗子透出一点昏黄。栏杆外检修梯结着薄冰。"
    },
    "hall": {
      "n": "站厅",
      "d": "站厅积着半指厚的灰，取暖炉封了火，炉台上一只搪瓷缸还温着。公告栏钉满通知，三条走廊分别通向值班调度室、机电室和机房。"
    },
    "duty": {
      "n": "值班调度室",
      "d": "调度台占了半间屋，一排按钮罩着透明防尘罩，台角开着回执口。墙上挂着工具柜，桌上摊着交接班手账，书架上立着卷边的规程手册。"
    },
    "power": {
      "n": "机电室",
      "d": "柴油发电机蹲在角钢机座上，机身铭牌斑驳，读得出 RW-31 字样。里侧立着配电柜，柜门挂牌锁死；墙根蓄电池架码着 8 块应急电池。"
    },
    "machine": {
      "n": "机房",
      "d": "驱动轮悬在头顶，拇指粗的钢丝绳从轮槽里穿出去，一头扎进风雪里。墙脚是液压张紧泵和退闸手轮，角落小门通着检修间。"
    },
    "cab": {
      "n": "车厢",
      "d": "车厢里空荡荡的，座椅上落满雪粉，金属扶手冷得粘手。门边的黄铜铭牌擦得发亮，行车记录板留着半页粉笔字。"
    },
    "tools": {
      "n": "检修间",
      "d": "检修间窄得只容一张工作台。零件架上码着备用闸瓦和喷灯，墙面挂具齐全，一张清点卡用铅笔写着预检条目。"
    }
  },
