{
  "title": "闸下的旧番号",
  "intro": "汛期头一夜，你被困在防洪闸底的人防工事里。出口闸盘认的是工事旧番号，可番号早被人用电报码改了写法；赶在启闭机下一轮测试前，照东口走出去。",
  "start": "ante",
  "rooms": {
    "ante": {
      "n": "闸底前室",
      "d": "头顶滚着启闭机的闷响，墙上的出入口方位图边角卷起。三个门洞分通值班室、泵房和中央通道，墙架上挂着一只手电筒。墙角竖梯锈得发红，井下涨着黑水。"
    },
    "duty": {
      "n": "值班室",
      "d": "值班室里一股旧纸味。桌上摊着值班日志，抽屉上着窄口锁，北墙的小门虚掩着，墙钩上还挂着黄铜指北针。"
    },
    "pump": {
      "n": "泵房",
      "d": "黑得伸手不见五指，排水泵蹲在坑沿，坑底汪着死水。角落立着一只缠铁丝的工具柜。"
    },
    "gallery": {
      "n": "中央通道",
      "d": "拱顶通道向三面岔开：东口装着齿条闸门，西口挂着挡板，北口被塌砖堵死。排水槽贴着地面向西延伸。"
    },
    "store": {
      "n": "库房",
      "d": "挡板后是库房，木架码着桐油桶和麻袋。靠墙的料柜挂着黄铜小锁，锁鼻被摸得油亮。"
    },
    "tunnel": {
      "n": "主口甬道",
      "d": "出口防护门立在甬道尽头，门楣镶着三枚铅字，门旁闸盘装着三只转轮。旧漆编号 044 被刀刮花了一半。"
    }
  },
  "items": {
    "flashlight": "手电筒",
    "compass": "黄铜指北针",
    "store_key": "拴木牌的小钥匙",
    "crowbar": "撬棍",
    "codebook": "半册电码簿"
  },
