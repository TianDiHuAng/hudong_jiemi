{
  "title": "赎当的清早",
  "intro": "老朝奉一夜未归，柜上只剩你一个学徒。头位客人攥着到期的当票来赎那对翠镯——架柜两扇各认各的锁：左扇认暗码，右扇认戥秤。",
  "start": "counter",
  "rooms": {
    "counter": {
      "n": "柜堂",
      "d": "高柜顶到梁下，左扇嵌着铜暗码盘，右扇吊一杆小戥，戥钩上拴着块木牌。柜台外候着位夹袍客人，布帘后通账房。"
    },
    "ledger": {
      "n": "账房",
      "d": "账桌上算盘压着暗码底簿，抽屉虚掩半指缝。板梯上通卧房，侧门铜锁后是首饰房，后门半敞，漏进天井的潮气。"
    },
    "jewel": {
      "n": "首饰房",
      "d": "百宝格分格码着翠件软缎，格尾蹲着一只缺盖的砝码匣，匣里隐约有铜铁相碰的轻响。"
    },
    "loft": {
      "n": "朝奉卧房",
      "d": "烟榻没铺，残灯结着灯花。镇纸底下压着张烟笺，砚池干了两日，桌上还搁着封拆开的信。"
    },
    "court": {
      "n": "天井",
      "d": "青石地缝生了苔，井台沿口湿得发亮，探头就能望见井底的暗。堆房与门房的门都虚掩着。"
    },
    "store": {
      "n": "堆房",
      "d": "架上码着当进的皮货木器，签牌翻卷，樟脑味里混着股麻绳的汗味。"
    },
    "gate": {
      "n": "门房",
      "d": "一铺小炕温吞吞的，老何抱着铜脚炉打盹，门闩上还挂着昨夜没摘的铜铃。"
    }
  },
