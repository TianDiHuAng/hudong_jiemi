{
  "title": "开窖的秤砣",
  "intro": "山谷里的老酒厂明早移交，你受托清点窖里最后一窖陈酒。投料记录与秤砣配比指认同一组橡木桶——挂砣的次序错了，酒窖铁门就一分不开。",
  "start": "yard",
  "rooms": {
    "yard": {
      "n": "厂院",
      "d": "荒草从石缝里挤出来，锅炉房的烟囱歪着半边。五条路分别通向办公室、工房、蒸酿车间、烘粮棚和窖外廊，山风把酒糟的酸味吹散了大半。"
    },
    "office": {
      "n": "办公室",
      "d": "算盘上压着投料记录簿，窗台搁着一盒受潮的火柴。桌角玻璃板下垫着旧照片，墙皮剥落处露出砌墙的毛笔字。"
    },
    "workroom": {
      "n": "工房",
      "d": "梁下吊着一杆大吊秤，秤钩旁码着三只无字砣。墙上记账板写满粉笔账，另一条门通办公室，角落的工具挂板空了大半。"
    },
    "distill": {
      "n": "蒸酿车间",
      "d": "甑桶掀着盖，冷凝蛇管垂在槽头，地面的酒糟干成了饼。房梁上挂着一串空酒坛，坛口朝下。"
    },
    "kiln": {
      "n": "烘粮棚",
      "d": "烘粮的竹榻空着，火道口积着灰。墙上还挂着去年的高粱穗，穗壳在穿堂风里沙沙作响。"
    },
    "porch": {
      "n": "窖外廊",
      "d": "窖门是包铁的老门，门上一排三只挂钩，门边木橛上挂着一只长柄酒提。檐下的光线昏昏，门缝里黑得深。"
    },
    "cellar": {
      "n": "酒窖",
      "d": "酒窖凉得沁骨，橡木桶沿壁排成三列，桶箍铜牌的錾字蒙着灰。窖顶的气眼漏下一线天光，照见浮尘。"
    }
  },
