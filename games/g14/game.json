{
  "title": "收桥之后",
  "intro": "夜雨刚歇，树屋旅馆把吊桥全收了。配重筐缺一斤就咬不住齿，把桥一座座放回树冠之间，循着苔痕下到山道去。",
  "start": "deck",
  "rooms": {
    "deck": {
      "n": "主台",
      "d": "围着粗壮树干搭出一圈主台，檐下挂着水葫芦，角落堆着成捆缆绳。台沿垂藤直下树冠，藤皮糟朽发黑。两座吊桥的绞盘架分立左右。"
    },
    "office": {
      "n": "值班板房",
      "d": "管理日志和一杆小秤挂在板房墙上，木柜敞着门。窗缝漏进一线天光，照见浮尘乱舞。"
    },
    "eb": {
      "n": "东桥头",
      "d": "东桥头的绞盘架下吊着配重筐，筐沿刻着斤两线。桥板收拢在架边，齿条闸咬死不放。"
    },
    "et": {
      "n": "东台",
      "d": "晒台竹竿上晾着雨衣，木棚门被一团旧缆的死结缠住。台板缝里长着厚苔，雾气贴着树冠飘。"
    },
    "wb": {
      "n": "西桥头",
      "d": "西桥头同样吊着配重筐，筐边木牌写着斤两规矩。桥索垂进云雾，望不见对头。"
    },
    "wt": {
      "n": "西台",
      "d": "背阴的西台搭着两块跳板，板底苔痕一厚一薄。台角立着竹牌，字被雨水洇过。"
    },
    "exitp": {
      "n": "出口台",
      "d": "老榕横枝上架空着出口台，栈道口斜向下通进雾里，口上横着一根带销的木杠。"
    }
  },
