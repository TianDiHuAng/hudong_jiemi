{
  "title": "三更药对",
  "intro": "三更梆子刚过，师父留话：今夜有人上门取补血汤的药对。可百子柜被人按君臣佐使重新排过，老戥子也拆了件——你得理清斗位、装好戥子，开了后堂药库把药递出去。",
  "start": "hall",
  "rooms": {
    "hall": {
      "n": "堂前厅",
      "d": "柜台上戥子拆散了件，算盘边压着处方笺。四条门通向百子柜廊、账房、碾煎房和候诊廊，夜风从门槛缝里往柜底下钻。"
    },
    "cabinet": {
      "n": "百子柜廊",
      "d": "整面墙的百子柜从地排到梁，最高一排四只大斗签着君、臣、佐、使。矮柜上的常用饮片见了底，药香发苦。"
    },
    "study": {
      "n": "账房",
      "d": "账房只点一盏豆油灯。进货账册摊在案上，朱批密密的；一册手抄药性赋压着账角，书页里夹着张折起的字条。"
    },
    "work": {
      "n": "碾煎房",
      "d": "大药碾嵌在青石槽里，碾轮斜卡在槽尾；泥炉上煨着一只药罐，罐口用荷叶封着，药气早散尽了。"
    },
    "yard": {
      "n": "晾药天井",
      "d": "天井里竹匾一层摞一层，晾着切好的饮片。墙根大水缸结着青苔，檐溜滴进石臼，一声一声很慢。"
    },
    "porch": {
      "n": "候诊廊",
      "d": "候诊的长条凳靠墙排开，尽头是后堂药库的门，门鼻上一把黄铜大锁，锁面嵌着两格深浅不一的药槽。"
    },
    "store": {
      "n": "后堂药库",
      "d": "药库高及屋顶，药架分层码着瓷坛与樟木匣。最高一层搁着一只系锦绳的小匣，地面撒的干石灰踩上去簌簌作响。"
    }
  },
