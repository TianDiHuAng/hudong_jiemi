{
  "title": "背板上的旧账",
  "intro": "拍卖行明早九点来提画。匿名条、电话留言和两册台账各说各话，画框背板的暗号也被人换了一套字母——让真话获胜，打开背板夹层，取出那份盖火漆的原始鉴定书。",
  "start": "bench",
  "rooms": {
    "bench": {
      "n": "修复台区",
      "d": "画架上的老油画背板朝外，右下角的封蜡压着火漆印——百年光油层脆，动刀即毁。三盏修图灯只亮一盏，窗外是晚风拍打百叶的声音。"
    },
    "crate": {
      "n": "画箱暂存间",
      "d": "空画箱立在架子旁，内衬掀起一角。地上散落着包装钉，标签写着明早九点提货。"
    },
    "dark": {
      "n": "观察间",
      "d": "红灯把整间屋子泡成暗棕色，观察台上摆着红外底片格，壁柜里挂着放大夹。窗帘拉得严实。"
    },
    "store": {
      "n": "颜料库",
      "d": "台账架立在门口，新旧两册并排插着。货架上色粉罐按色系排开，罐身的进口批号字头磨得发亮。"
    },
    "office": {
      "n": "驻点办公桌",
      "d": "办公桌上是委托合同和提货单，电话留言机的红灯一闪一闪。椅背上搭着拍卖行的制服外套。"
    },
    "hall": {
      "n": "楼梯间",
      "d": "应急灯绿着，门禁面板黑着屏。公告栏贴着明早的提货流程，骑缝章在纸角压出半个圆。"
    },
    "loft": {
      "n": "夹层资料阁",
      "d": "木梯上去的夹层低得顶头，修复手册和周先生的笔记排在一格。灰尘在灯柱里浮着，落得很慢。"
    },
    "sink": {
      "n": "清洗间",
      "d": "水槽里泡着几支洗笔，溶剂柜贴着挥发性标签。窗台那盆绿萝蔫着，叶尖卷了边。"
    }
  },
