{
  "title": "缺角的纪年",
  "intro": "沙暴橙色预警在电台里循环。保险柜里是 M7 新出土的墓志拓片，柜码是老队长留在日晷盘上的谜——赶在沙墙压顶前，把纪年补全、把拓片装筒带下山。",
  "start": "camp",
  "rooms": {
    "camp": {
      "n": "宿营帐",
      "d": "行军床没叠，床脚帆布包敞着口。帐杆上挂着风镜和马灯，值班笔记用帐钩别在床头。"
    },
    "plaza": {
      "n": "场心",
      "d": "营地中央立着老日晷，石盘刻度磨得发亮。风向袋绷得笔直，天边沙墙已看得见轮廓。木牌上写着：沙暴将至，勿出营地。"
    },
    "work": {
      "n": "工作帐",
      "d": "修复台占去半间帐，台上压着一张缺角的拓片校样，右下缺口断得整齐。台边立着出土登记簿。"
    },
    "test": {
      "n": "探方帐",
      "d": "标本架立在探方帐正中，M7 的标本匣摆在最上层，黄铜匣扣擦得干净。台面摊着筛漏的碎陶。"
    },
    "sieve": {
      "n": "筛场",
      "d": "筛余的沙堆得像座小山，风一过就扬起一层浮沙。筛架空着，网眼上挂着干硬的泥壳。"
    },
    "store": {
      "n": "库物帐",
      "d": "库物帐的铁架上放着筒箱，帐角摞着空白登记签。箱面的铜锁牌刻着库物二字。"
    },
    "garage": {
      "n": "车场",
      "d": "吉普车头朝着下山的方向，车门虚掩。收音机屏蒙着灰，副座上丢着半包烟。"
    },
    "relics": {
      "n": "文物帐",
      "d": "文物帐里码着寄存箱，保险柜蹲在最里侧，三位转盘擦得锃亮，柜门贴着泛黄的启封条。"
    }
  },
