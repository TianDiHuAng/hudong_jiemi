{
  "title": "封冻前收闸",
  "intro": "寒潮半夜过境，结晶池的闸板还敞着。卤度计摔碎了，取样桶散了板——赶在池面封冻前，把闸板配平收起。",
  "start": "dike",
  "rooms": {
    "dike": {
      "n": "一号池埂",
      "d": "池面结了层薄冰，埂头风向袋绷成一条直线，告示牌上粉笔字未干。埂沿散着碎玻璃，桩上挂着麻绳。"
    },
    "gatehouse": {
      "n": "闸房",
      "d": "绞盘与吊梁横在房心，梁上木牌字迹发白。墙根挤着五块配重石，磅秤就搁在石堆旁，抽屉半开。"
    },
    "beach": {
      "n": "滩上",
      "d": "盐沙被风刮出细纹，桶板散在滩窝里，铁箍半埋着。滩口的卤沟泛着白沫，风一过就扬盐末。"
    },
    "shed": {
      "n": "值班房",
      "d": "一桌一炕，桌上的老簿子翻开着，炕头还温着半壶咸茶，窗纸让风顶得一鼓一鼓。"
    },
    "pump": {
      "n": "泵房",
      "d": "泵轴裹着草绳，油壶冻硬了嘴。管子里存着死水，门轴上挂着的草帘结了盐霜。"
    },
    "yard": {
      "n": "坨地",
      "d": "大盐坨苫着三层席，迎风那面压了整排卤袋。坨脚的盐包码得齐整，苫绳绷得咯咯响。"
    }
  },
