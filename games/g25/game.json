{
  "title": "被调包的二百九十米",
  "intro": "极夜第九十天，主站来电：这批待复核冰芯里混进了一支不该存在的芯。凭断代影印表和钻孔柱状图把它锁出来，封舱上报——复核组的雪地车已经在路上。",
  "start": "office",
  "rooms": {
    "office": {
      "n": "库房值班室",
      "d": "值班台上的日志摊开着，台钩挂着一把拴木牌的铜钥匙。台历停在昨天，暖风机嗡嗡地顶着门缝的风。"
    },
    "archive": {
      "n": "资料间",
      "d": "铁皮资料柜靠墙立着，柜顶摞着历年复核回执的木盒。灯罩上结了层薄霜，光线发闷。"
    },
    "drill": {
      "n": "钻孔资料间",
      "d": "两张钻孔柱状图钉满一面墙，图边别着各孔的取芯台账。暖气片半冷，铅笔字冻得发脆。"
    },
    "corridor": {
      "n": "库房走廊",
      "d": "走廊尽头的库门敞着一扇，地上还留着风灌进来的雪痕。门楣正中钉着一根褪色的红布条，墙上挂着库架平面图。"
    },
    "rackA": {
      "n": "A 区架排",
      "d": "西排铁架一路排开，架沿的米数刻痕自北端起一段比一段深。头灯的光扫过去，丙位架的标签边角翘着。"
    },
    "rackB": {
      "n": "B 区架排",
      "d": "东排架位空了大半，几支待年检的旧芯立着，标签卷了边。地面的霜花上印着一串散乱的脚印，裸手贴冰即粘。"
    },
    "prep": {
      "n": "样品前处理间",
      "d": "比对台的漫射灯管闪了两下才稳住，台面留着上一批样品的蜡痕。除湿机吐着白汽。"
    },
    "gear": {
      "n": "备品间",
      "d": "头灯充电柜嵌在墙里，三盏绿灯亮着。挂钩上的防寒服袖口冻得硬邦邦，碰一下铮铮作响。"
    },
    "core": {
      "n": "复核舱室",
      "d": "复核舱立在室中央，舱温表停在零下二十六度。发报机的键钮擦得发亮，天线馈线沿着墙角爬上屋面。"
    }
  },
