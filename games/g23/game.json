{
  "title": "压轴出场之前",
  "intro": "环球巡演第七十三站散场后的午夜。四只道具箱必须按出场顺序挂上中央吊架、配重筐配平，暗门下的地下库房里锁着明早要提的巡演总账和空中飞人的备用保险绳。",
  "start": "ring",
  "rooms": {
    "gate": {
      "n": "检票口",
      "d": "票亭卷帘落了一半，霓虹灯牌只剩个环字在闪。海报栏里环球巡演的招贴被夜风掀起一角。"
    },
    "ring": {
      "n": "圆场",
      "d": "场灯熄了大半，格构吊架横在头顶，滑轮组的钢索垂进黑暗。暗门四边包着黄铜，锁链穿过滑轮吊向配重筐。"
    },
    "wardrobe": {
      "n": "服装间",
      "d": "针线筐里堆着亮片头饰，缝纫台上摊着没锁完边的飞人披风。墙角是道具箱轨道的入口，散页就落在筐边。"
    },
    "office": {
      "n": "团长办公篷",
      "d": "折叠桌占去半间篷，日程板钉在篷布上，电话线卷成一团。办公桌带锁，抽屉钥匙孔磨得发亮。"
    },
    "stable": {
      "n": "马厩篷",
      "d": "美洲豹笼占了半边，垫草里有沙沙的动静，豹爪能从栏杆缝里甩出来。门后钉板上挂着钥匙和手电，喂食表压在钉板一角。"
    },
    "props": {
      "n": "道具库",
      "d": "四只道具箱靠墙码放，墙上到货清单写得明白：铃鼓 12、彩球 15、礼帽 9、扣件 6 公斤。台秤蹲在门边。"
    },
    "rigging": {
      "n": "绞盘棚",
      "d": "排程板挂满磁贴，绞盘手轮缠着防尘布。配重筐轨道从棚顶穿出去，平衡盘的指针停在红区边上。"
    },
    "hoist": {
      "n": "吊架平台",
      "d": "爬上格构桁架的平台，四只吊钩排成一列，最里档已经挂着铃鼓箱。风把篷布吹得鼓起来又塌下去。"
    },
    "cellar": {
      "n": "地下库房",
      "d": "铁架码得整整齐齐，玻璃柜里锁着巡演总账。应急荧光漆沿着梯口一路刷下来，照见货位牌上一串城市名。"
    }
  },
