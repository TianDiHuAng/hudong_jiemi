      "d": "夜班台上的登记本摊开着，门口小黑板留着上一班的粉笔字。恒温屏红字跳在 31.4℃，三扇门通向门厅、苗床和药剂间。"
    },
    "headhouse": {
      "n": "门厅值班室",
      "d": "衣帽钩上挂着雨衣和值班表，对讲机在充电座上闪红灯。玻璃门外是园区的黑，保安亭早没了人。"
    },
    "store": {
      "n": "药剂贮藏间",
      "d": "天平架在防酸台面上，砝码盒和母液粉罐排在格架里。屋顶排风扇停了，药味沉甸甸压在灯下。"
    },
    "orchid": {
      "n": "兰花苗床",
      "d": "三排蝴蝶兰的叶尖开始发软，温度计顶在 31℃。苗床尽头一道铁门虚掩着，机房的水泵声隐隐传过来。"
    },
    "fern": {
      "n": "蕨类阴棚",
      "d": "加湿帘淌着水，值班员小林的工具袋挂在门后钉子上。角落的加湿器断了电，叶子上的水珠凝着不动。"
    },
    "boiler": {
      "n": "机房",
      "d": "热水管路爬满墙，喷雾主管的冻裂断口就在阀座旁。地上摊着一只零件箱，旁边贴着中压蒸汽的警示带。"
    },
    "workshop": {
      "n": "工具棚",
      "d": "管钳按尺寸挂了一排，备用阀芯躺在抽屉格上。棚里堆着空营养桶，油灯味混着橡胶圈的气味。"
    },
    "mister": {
      "n": "喷雾控制间",
      "d": "控制柜蒙着防尘罩，吸药座空着。柜门挂着小锁，面板底下贴着一张卷了边的启动口诀。"
    }
