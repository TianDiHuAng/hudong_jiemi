{
  "title": "零点自动开播",
  "intro": "你上山检修避雪，却被反锁在这座停播多年的电台里。零点整设备自顾自开了机，大门电吸锁随发射机一起上了电——照老规矩把收播走完，这一夜播完，门才放行。",
  "start": "duty",
  "rooms": {
    "duty": {
      "n": "值班室",
      "d": "值班室的灯自顾自亮着，台历翻在停播那天的日期上。桌上摊着值班日志，台历架靠在桌角。"
    },
    "lobby": {
      "n": "门厅",
      "d": "门厅正对玻璃大门，门框上的电吸锁亮着红灯，嗡嗡作响。墙上挂着发报时刻表和全台合影。"
    },
    "control": {
      "n": "播控室",
      "d": "播控台上三路推子标着甲、乙、丙，台沿压着水洇的排播单。监测音箱沙沙响着，正播台里的自动节目。"
    },
    "record": {
      "n": "唱片间",
      "d": "带架一排排立着，台歌带和点播带都在原位，唯独天气旧录的带位空着。桌角搁着一台手摇唱机。"
    },
    "mail": {
      "n": "收发室",
      "d": "分格木架上插着几封来信，格上贴着收件人名条。角落蹲着一只上挂锁的点播木箱。"
    },
    "roof": {
      "n": "天台",
      "d": "天台的雪没过脚踝，天线座拉着斜索，索上结着暗冰。雪地上只有一串旧脚印，到檐口就断了。"
    },
    "storage": {
      "n": "储藏间",
      "d": "储藏间窄得转不开身，架上码着备用话筒和唱针盒，成卷的导线按年月贴着签。"
    }
  },
