{
  "title": "封站前的真话",
  "intro": "零点整回收站拉闸封站。站长权限卡被误投进暂存笼，三台报废机器人的自检日志各执一词——真话只有一句。赶在断电前开笼取卡、给主控台续电复位，从质检闸口走出去。",
  "start": "guard",
  "rooms": {
    "guard": {
      "n": "门卫室",
      "d": "门卫室里交接板写满粉笔字，总断路闸的红手柄就在手边，闸旁红牌：拉闸即封站，不可逆转。玻璃窗正对分拣大厅，传送带静静停着。"
    },
    "hall": {
      "n": "分拣大厅",
      "d": "传送带横贯大厅，搬运机与焊接机并排蹲在带上，胸腔检修口都敞着扣。闸口方向的灯箱闪着待检的黄光。"
    },
    "maint": {
      "n": "检修间",
      "d": "工具墙按形制挂着扳手与钳套，充电座空着。台面上摊着半册检修规程，纸角卷了边。"
    },
    "shelf": {
      "n": "备件架区",
      "d": "钢架上码着封存的备件，公告板钉着今晨的分流单与两张回执，图钉锈出了黄痕。"
    },
    "charge": {
      "n": "充电桩间",
      "d": "四座充电桩只剩两座亮着虚电，清扫机与扫地机并排接在桩上，指示灯一明一灭。"
    },
    "cage": {
      "n": "暂存笼区",
      "d": "铁丝网笼顶到梁，笼门挂着联锁排杆，三根拉杆标着三台机器的编号，旁边挂着一块检修规程牌。"
    },
    "control": {
      "n": "控制室",
      "d": "主控台的屏幕蒙着灰，电池仓的仓盖敞着，指示灯全灭着。墙上贴着上月的复位记录，落款盖着站章。"
    },
    "exitgate": {
      "n": "出站站台",
      "d": "站台卷帘升了一半，质检闸口的读卡槽蒙着雾气，闸外就是夜里冻实的料场。"
    }
  },
