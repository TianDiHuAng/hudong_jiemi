{
  "title": "红灯下的最后一张",
  "intro": "主街停电，暗房里只剩红灯亮着。师傅赶天亮要交的那张放大照停在半路：放大机散着件，三只药盘都还没冲药。",
  "start": "shop",
  "rooms": {
    "shop": {
      "n": "店堂",
      "d": "货架蒙着防尘布，橱窗样照歪了两张。玻璃柜后是账台，抽屉关着；黑布帘后通暗房，侧门挂着杂物间的牌。"
    },
    "darkroom": {
      "n": "暗房",
      "d": "红灯泡昏昏地亮着。放大机拆散在案上，灯室空着口，三只白瓷盘一字排开，药粉罐立在架上，桌上搁着底片袋。"
    },
    "closet": {
      "n": "杂物间",
      "d": "旧报纸卷成捆靠墙码着，断头桌下滚着只木匣，显影药味从门缝里渗进来。"
    },
    "mixery": {
      "n": "药水间",
      "d": "架上整瓶定影液码了两排，量杯倒扣着沥水，地上留着昨夜溅出的药渍。"
    },
    "stair": {
      "n": "楼梯间",
      "d": "往上去师傅小间的台阶没进黑暗里；往下去地窖，梯沿磨得溜光，没有一盏灯，师傅留过话今晚不修电。"
    },
    "yard": {
      "n": "后院",
      "d": "晾片绳横过院子上空，木夹子空着一排。墙根水缸里浮着只水瓢，缸沿搭着半片旧网。"
    }
  },
  "items": {
